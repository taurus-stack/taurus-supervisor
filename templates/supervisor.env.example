# Taurus Supervisor Configuration

# Base directory
BASE_DIR=/opt/taurus

# Primary server URL (use HTTPS in production)
SERVER_URL=https://taurus.example.com

# Host ID (obtained after registration)
# HOST_ID=your-host-id

# Request signing key (optional, issued by Server during registration)
# Supports plaintext or Fernet encrypted format (fernet:xxx)
# REQUEST_SIGNING_SECRET=your-secret-key-here
# REQUEST_SIGNING_SECRET=fernet:gAAAAABlZ...

# Configuration encryption master key (used to decrypt Fernet encrypted configurations)
# CONFIG_ENCRYPTION_KEY=your-master-key-here

# SSL configuration (for Supervisor's own HTTPS connection to Server)
SUPERVISOR_SSL_VERIFY=true                    # Whether to verify SSL certificate (must be true in production)
SUPERVISOR_SSL_CA_PATH=/etc/taurus-supervisor/ca.crt  # Custom CA certificate path (optional, required for self-signed certificates)

# Logging configuration
LOG_DIR=/var/log/taurus-supervisor
LOG_MAX_BYTES=10485760  # Maximum log file size (bytes), default 10MB
LOG_BACKUP_COUNT=5      # Number of log files to keep, default 5

# Log forwarding configuration (remote log collection, similar to rsyslog)
# Enable by setting server_url and configuring the following options
LOG_BATCH_SIZE=100           # Number of logs to send in a batch, default 100
LOG_MAX_BUFFER_SIZE=10000    # Maximum number of logs in buffer, default 10000
LOG_SEND_INTERVAL=30         # Send interval (seconds), default 30
LOG_MIN_LEVEL=ERROR          # Default minimum log level (DEBUG/INFO/WARNING/ERROR/CRITICAL). Use ERROR in production for zero overhead, lower temporarily via backend commands when troubleshooting